{
  "name": "yak-agent-harness-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "llm:01": "node --env-file=.env --import tsx mvp/01-llm/01-basic-call/index.ts",
    "llm:02": "node --env-file=.env --import tsx mvp/01-llm/02-message-roles/index.ts",
    "llm:03": "node --env-file=.env --import tsx mvp/01-llm/03-multi-turn/index.ts",
    "mvp:llm": "node --env-file=.env --import tsx mvp/01-llm/src/index.ts",
    "test:llm": "node --import tsx --test mvp/01-llm/test/llm.test.ts",
    "mvp:tool": "tsx mvp/02-tool/src/index.ts",
    "mvp:agent-loop": "tsx mvp/03-agent-loop/src/index.ts",
    "mvp:session": "tsx mvp/04-session/src/index.ts",
    "mvp:context": "tsx mvp/05-context/src/index.ts",
    "mvp:compaction": "tsx mvp/06-compaction/src/index.ts",
    "mvp:permission": "tsx mvp/07-permission/src/index.ts",
    "mvp:recovery": "tsx mvp/08-recovery/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
